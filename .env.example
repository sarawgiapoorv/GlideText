# GlideText Environment Variables (Example Template)
# Copy this file to .env and fill in your values if configuring via environment variables.

# Priority 1: FreeLLMAPI configuration
FREELLMAPI_URL=http://127.0.0.1:3001
FREELLMAPI_API_KEY=
FREELLMAPI_DIR=C:\path\to\your\freellmapi

# Priority 2: Google Gemini API (optional, can also be configured securely in GUI Settings via Windows Credential Manager)
GEMINI_API_KEY=

# Priority 3: Local LLM / Ollama configuration
OLLAMA_HOST=http://127.0.0.1:11434
LOCAL_MODEL=llama3.2:3b

# Audio & Speech-to-Text configuration
DEVICE_INDEX=auto
WHISPER_MODEL=base
WHISPER_LANGUAGE=auto
